{
  "name": "rego-dos-campos-web",
  "version": "3.0.0",
  "private": true,
  "description": "Web de Rego dos Campos, finca de aguacates en Galicia",
  "scripts": {
    "build:scene": "esbuild src/scene.js --bundle --minify --format=iife --target=es2019 --outfile=assets/js/scene.js --legal-comments=none",
    "serve": "python3 -m http.server 8000",
    "build:modelo-entero": "node tools/optimize-entero.mjs originales/aguacate_hiperrealista_web.glb assets/models/aguacate.glb 0.25",
    "build:modelo-partido": "node tools/optimize-partido.mjs originales/aguacate_partido_web.glb assets/models/aguacate-partido.glb 0.3"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "three": "0.186.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5"
  }
}
